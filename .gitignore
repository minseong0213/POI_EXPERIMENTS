/new/*/work/
/new/*/runtime/
/new/**/*.parquet
/new/**/*.npy
/new/**/*.pt
/new/**/*.ckpt
/new/**/*.tabpfn_fit

# Local archive and non-public experiment state. Keep these on disk, but do not
# publish them with the code/results repository.
/legacy/
/resources/
/docs/overview/
/docs/assets/poi-*
# These local links point into the excluded legacy tree and would be broken on
# GitHub. Current unified-run reports below replace them as publication inputs.
/docs/experiments/2026-10-01_remediation_execution.md
/docs/experiments/2026-10-06_completion_check.md
/docs/experiments/2026-10-06_no_coordinate_comparison.md
/docs/experiments/orchestration_protocol.md
