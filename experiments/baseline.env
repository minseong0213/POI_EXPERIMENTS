# HOST/PORT come from GPU_CONNECTION_FILE supplied to the orchestrator.
HOST="${HOST:-}"
PORT="${PORT:-}"
SOURCE="/home/mlops/orca/projects/poi"
REF="HEAD"
PROJECT_NAME="poi"
