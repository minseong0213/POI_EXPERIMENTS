COMMAND=(bash -c 'python -m pip install tabpfn==8.1.0 pandas pyarrow PyYAML matplotlib seaborn scikit-learn && python -m pip install --no-deps --no-build-isolation . && mkdir -p /workspace/data/poi-attack-eval && rclone copyto r2:ml-experiments/results/poi/poi-attacks-20260915-003/reports/01_attack_generation/tables/attacks.parquet /workspace/data/poi-attack-eval/attacks.parquet && rclone copyto r2:ml-experiments/results/poi/poi-adversarial-20260915-001/inputs/model_ranking_validation.csv /workspace/data/poi-attack-eval/model_ranking_validation.csv && ATTACKS_FILE=/workspace/data/poi-attack-eval/attacks.parquet SELECTION_RANKING=/workspace/data/poi-attack-eval/model_ranking_validation.csv python -m poi.attack_evaluate --output "$RESULT_DIR/reports/06_attack_evaluation"')
